// When adding a new model, also add ENABLE ROW LEVEL SECURITY and a policy
// for it in supabase/rls.sql, then re-run that file in the Supabase Dashboard.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  name        String
  targetEnv   String    @map("target_env")
  iacTool     String    @map("iac_tool")
  model       String
  mermaidCode String    @default("") @map("mermaid_code")
  configYaml  String    @default("") @map("config_yaml")
  githubRepo    String?   @map("github_repo")
  githubBranch  String?   @map("github_branch")
  status      String    @default("active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  iacCode     Json?     @map("iac_code")
  iacStale    Boolean   @default(false) @map("iac_stale")
  messages    Message[]

  @@map("sessions")
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  sessionId      String   @map("session_id") @db.Uuid
  role           String
  content        String
  diagramUpdated Boolean  @default(false) @map("diagram_updated")
  createdAt      DateTime @default(now()) @map("created_at")
  session        Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("messages")
}


model CredentialProfile {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  provider      String
  name          String
  credentials   String
  defaultRegion String   @map("default_region")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("credential_profiles")
}

model UserApiKey {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  provider     String
  encryptedKey String   @map("encrypted_key")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([userId, provider])
  @@map("user_api_keys")
}
